# GridWise LLM provider chain.
# Keep at least one provider key. Multiple keys enable automatic fallback.
# Recommended free-development setup: Gemini + Groq.
LLM_PROVIDER_ORDER=groq,gemini,openrouter,deepseek
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=10

# Google Gemini (Google AI Studio free tier for eligible models)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=low

# Groq free tier / account limits are model-specific.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# OpenRouter fallback. Free plan currently has a 50 requests/day platform limit.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Optional DeepSeek fallback / primary if you obtain an API balance or granted credits.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false

# API server
PORT=8000
